# Neon Postgres connection string.
# Get it from the Vercel dashboard: Storage -> Create Database -> Neon.
# Vercel injects this automatically in production; copy it here for local dev.
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Optional shared password gating the whole site. Leave unset for an open instance.
HOUSE_PASSWORD=""
